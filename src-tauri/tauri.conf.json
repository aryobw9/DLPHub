{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DLPHub",
  "version": "0.1.7",
  "identifier": "com.aryo.dlphub",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DLPHub",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "devtools": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' asset: https: http:; connect-src 'self' https://deadlockpersian.com http://92.42.207.96:48080 ipc: http://ipc.localhost; img-src 'self' data: asset: https: http:; font-src 'self' asset: data:; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}